# Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# AI Provider API Keys (at least one is required)
# ============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Runtime
# ============================================================================
NODE_ENV=development
PORT=3000

# ============================================================================
# Agent / provider (optional)
# ============================================================================
AGENT_PROVIDER=anthropic          # anthropic | openai
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# ============================================================================
# HTTP server (optional)
# ============================================================================
# AGENT_SERVER_HOST=127.0.0.1
# AGENT_SERVER_API_KEY=            # required when binding to a non-loopback host
# AGENT_SERVER_ORIGIN=http://localhost:3000
# AGENT_SERVER_ALLOW_MUTATIONS=false
# AGENT_SERVER_RATE_MAX=30
# AGENT_SERVER_RATE_WINDOW_MS=60000

# ============================================================================
# Google sign-in via Firebase Auth (optional)
# ============================================================================
# FIREBASE_PROJECT_ID=
# FIREBASE_WEB_API_KEY=            # public web config values
# FIREBASE_APP_ID=
# FIREBASE_AUTH_DOMAIN=            # defaults to <project>.firebaseapp.com
# AGENT_ALLOWED_EMAILS=you@example.com,friend@example.com

# ============================================================================
# Public chat (no tools): per-user history in Supabase, daily quotas
# ============================================================================
# AGENT_PUBLIC_SIGNUP=true         # any Google account with a verified email may use /api/chat
#                                  # (the agent with tools stays limited to AGENT_ALLOWED_EMAILS)
# AGENT_BLOCKED_EMAILS=            # comma-separated emails refused even in public mode
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=       # server only, never expose to the browser; run db/supabase.sql first
# CHAT_DAILY_TOKENS=50000          # per user per UTC day (estimated tokens)
# CHAT_GLOBAL_DAILY_TOKENS=2000000 # all users together; the service stops when reached
# CHAT_DAILY_BUDGET_USD=5          # optional: with the price below, lowers the global cap
# CHAT_PRICE_PER_MTOKENS_USD=3     # blended price per million tokens of your model
# CHAT_MAX_OUTPUT_TOKENS=1500
# CHAT_MAX_INPUT_CHARS=8000
# CHAT_MAX_CHATS=200
# CHAT_RATE_PER_MINUTE=20
# CHAT_SYSTEM_PROMPT=

# ============================================================================
# Per-user sandboxes for the code agent (E2B)
# ============================================================================
# AGENT_SANDBOX=e2b                # signed-in users run the agent in their own E2B sandbox;
#                                  # the server refuses to start if E2B_API_KEY is missing
# E2B_API_KEY=                     # from e2b.dev (server only)
# E2B_TEMPLATE=                    # optional template that has Node 20+ (and the app prebuilt at /home/user/agent)
# AGENT_SANDBOX_REPO=https://github.com/paxni12345-web/agent-cli.git   # cloned and built inside a new sandbox
# AGENT_SANDBOX_REF=main
# AGENT_SANDBOX_IDLE_MINUTES=30    # a sandbox is removed this long after its last request
# AGENT_SANDBOX_MAX=3              # most sandboxes alive at once; more users see "busy"
