# Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# AI Provider API Keys (at least one is required)
# ============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Runtime
# ============================================================================
NODE_ENV=development
PORT=3000

# ============================================================================
# Agent / provider (optional)
# ============================================================================
AGENT_PROVIDER=anthropic          # anthropic | openai
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# ============================================================================
# HTTP server (optional)
# ============================================================================
# AGENT_SERVER_HOST=127.0.0.1
# AGENT_SERVER_API_KEY=            # required when binding to a non-loopback host
# AGENT_SERVER_ORIGIN=http://localhost:3000
# AGENT_SERVER_ALLOW_MUTATIONS=false
# AGENT_SERVER_RATE_MAX=30
# AGENT_SERVER_RATE_WINDOW_MS=60000

# ============================================================================
# Google sign-in via Firebase Auth (optional)
# ============================================================================
# FIREBASE_PROJECT_ID=
# FIREBASE_WEB_API_KEY=            # public web config values
# FIREBASE_APP_ID=
# FIREBASE_AUTH_DOMAIN=            # defaults to <project>.firebaseapp.com
# AGENT_ALLOWED_EMAILS=you@example.com,friend@example.com
