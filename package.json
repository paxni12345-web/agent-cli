{
  "name": "agent-cli",
  "version": "0.1.0",
  "description": "Production-ready autonomous AI coding agent CLI",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "agent": "./dist/cli.js",
    "agent-ui": "./dist/cli-ui.js",
    "agent-web": "./dist/web.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "start:ui": "node dist/cli-ui.js",
    "start:web": "node dist/web.js",
    "start:agent": "node dist/agent-server.js",
    "web:dev": "tsx src/web.ts",
    "ui:dev": "tsx src/cli-ui.ts",
    "agent:dev": "tsx src/agent-server.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\" \"tests/**/*.ts\"",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "cli",
    "agent",
    "autonomous",
    "ai",
    "coding",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-lambda": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/client-kms": "^3.600.0",
    "@google-cloud/storage": "^7.7.0",
    "@google-cloud/firestore": "^7.3.0",
    "@google-cloud/pubsub": "^4.0.7",
    "@azure/storage-blob": "^12.17.0",
    "@azure/cosmos": "^4.0.0",
    "@azure/service-bus": "^7.9.4",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "commander": "^12.1.0",
    "openai": "^4.77.3",
    "chalk": "^5.3.0",
    "ink": "^4.4.1",
    "react": "^18.2.0",
    "ink-text-input": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "zod": "^3.22.4",
    "validator": "^13.11.0",
    "xss": "^1.0.14",
    "winston": "^3.11.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "micromatch": "^4.0.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.45",
    "@types/validator": "^13.11.7",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/micromatch": "^4.0.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "prettier": "^3.1.1"
  }
}
