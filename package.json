{
  "name": "agent-cli",
  "version": "0.2.0",
  "description": "Autonomous AI coding agent for the terminal",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent": "./dist/cli.js",
    "agent-ui": "./dist/cli-ui.js",
    "agent-server": "./dist/agent-server.js",
    "irissetting": "./dist/cli-settings.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "start:ui": "node dist/cli-ui.js",
    "start:agent": "node dist/agent-server.js",
    "cli": "tsx src/cli.ts",
    "ui": "tsx src/cli-ui.tsx",
    "server": "tsx src/agent-server.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "cli",
    "agent",
    "autonomous",
    "ai",
    "coding",
    "anthropic",
    "openai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "chalk": "5.6.2",
    "commander": "12.1.0",
    "express": "4.22.2",
    "cors": "2.8.6",
    "ink": "4.4.1",
    "ink-text-input": "5.0.1",
    "openai": "4.104.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.2.45",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
