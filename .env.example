# Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# AI Provider API Keys (at least one is required)
# ============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Runtime
# ============================================================================
NODE_ENV=development
PORT=3000

# ============================================================================
# Agent configuration (optional overrides)
# ============================================================================
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-3-5-sonnet-20241022
AGENT_PERMISSION_MODE=normal
AGENT_MAX_ITERATIONS=30
AGENT_DEBUG=false

# Custom provider endpoint (optional)
# AGENT_BASE_URL=https://custom.endpoint.com

# HTTP server safety (optional)
# AGENT_SERVER_HOST=127.0.0.1
# AGENT_SERVER_ORIGIN=http://localhost:3000
# AGENT_SERVER_ALLOW_MUTATIONS=false

# ============================================================================
# Sandbox & execution isolation (optional)
# ============================================================================
# Docker tier
# AGENT_SANDBOX_DOCKER_USER=nobody
# AGENT_SANDBOX_TMPFS_MB=256
# AGENT_SANDBOX_REQUIRE_ISOLATION=false   # true = fail closed when Docker is unavailable
# Local tier (no Docker) — ulimit caps + unshare/setpriv guards
# AGENT_SANDBOX_LOCAL_CPU=30
# AGENT_SANDBOX_LOCAL_MEMORY_KB=1048576
# AGENT_SANDBOX_LOCAL_FILE_KB=262144
# AGENT_SANDBOX_LOCAL_PROCS=128
# AGENT_SANDBOX_LOCAL_DEMOTE_USER=true
# AGENT_SANDBOX_LOCAL_ISOLATE_NETWORK=auto # true | false | auto
# AGENT_SANDBOX_LOCAL_ALLOW_OUTSIDE=false
